#!/bin/bash

CHRONOS_PATH="$HOME/.local/share/chronos"

# Colors
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m'

echo "Syncing configs from git repo..."
echo ""

# Pull latest changes
cd "$CHRONOS_PATH"
if git pull; then
    echo ""
    echo "Copying configs to system..."
    
    # Copy config directories
    for config_dir in "$CHRONOS_PATH"/config/*; do
        if [ -e "$config_dir" ]; then
            dir_name=$(basename "$config_dir")
            cp -R "$config_dir" "$HOME/.config/"
            echo -e "${GREEN}✓${NC} Updated ~/.config/$dir_name"
        fi
    done
    
    # Copy bashrc
    cp "$CHRONOS_DIR/default/bashrc" "$HOME/.bashrc"
    echo -e "${GREEN}✓${NC} Updated ~/.bashrc"
    
    echo ""
    echo -e "${GREEN}Sync complete!${NC}"
else
    echo -e "${YELLOW}Git pull failed. Configs not updated.${NC}"
    exit 1
fi